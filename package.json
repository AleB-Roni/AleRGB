{
  "name": "spectra-rgb",
  "productName": "Spectra RGB",
  "version": "1.0.0",
  "description": "Universelle RGB-Steuerung für Windows – OpenRGB, Razer Chroma, Corsair iCUE, Logitech G HUB, SteelSeries GG, WLED, Philips Hue, Nanoleaf, Govee, Yeelight",
  "main": "src/main/main.js",
  "author": "Spectra RGB",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {},
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.spectra.rgb",
    "productName": "Spectra RGB",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "sdk", "to": "sdk", "filter": ["**/*"] }],
    "win": {
      "icon": "assets/icon.png",
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
